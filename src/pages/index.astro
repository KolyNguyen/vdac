---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro'; import { getCollection } from 'astro:content'; import { getLang, useTranslations, localize } from '../i18n';
const lang=getLang(Astro.url),t=useTranslations(lang); const services=(await getCollection('services')).sort((a,b)=>a.data.order-b.data.order); const news=(await getCollection('news')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<BaseLayout title="VDac | Giải pháp kế toán"><section class="hero"><div class="container"><div class="hero-copy"><p class="eyebrow">Accounting solutions / since 2012</p><h1>{lang==='vi' ? <>Tài chính vững vàng.<br/><em>Doanh nghiệp</em> bứt phá.</> : <>Financial confidence.<br/><em>Business</em> momentum.</>}</h1><p>{lang==='vi'?'VDac đồng hành cùng doanh nghiệp biến những con số phức tạp thành nền tảng vững chắc cho mọi quyết định lớn.':'VDac turns complex figures into a confident financial foundation for every important business decision.'}</p><a class="button" href={localize('/contact',lang)}>{t.consultation} <span>→</span></a></div><div class="hero-visual"><div class="shape shape-a"></div><div class="shape shape-b"></div><div class="report-card"><div class="report-top"><div><small>DOANH THU DỰ KIẾN</small><br/><strong>2.48B</strong></div><span class="meta">+18.6% ↑</span></div><div class="bars"><i class="bar" style="height:45%"></i><i class="bar" style="height:70%"></i><i class="bar" style="height:58%"></i><i class="bar" style="height:86%"></i><i class="bar" style="height:75%"></i><i class="bar" style="height:100%"></i></div><div class="dash-row"><div class="dash-chip">Dòng tiền<br/><b>Ổn định</b></div><div class="dash-chip">Báo cáo<br/><b>Tháng 08</b></div></div></div></div></div></section>
<section class="trust"><div class="container"><div><strong>12+</strong><span>Năm kinh nghiệm</span></div><div><strong>800+</strong><span>Doanh nghiệp tin tưởng</span></div><div><strong>30+</strong><span>Chuyên gia đồng hành</span></div><div><strong>98%</strong><span>Khách hàng hài lòng</span></div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><p class="eyebrow">Our expertise</p><h2>{lang==='vi'?'Giải pháp theo nhịp phát triển của bạn':'Solutions in step with your growth'}</h2></div><p>{lang==='vi'?'Từ vận hành hàng ngày đến chiến lược dài hạn, đội ngũ VDac luôn sẵn sàng ở bên doanh nghiệp.':'From daily operations to long-term strategy, VDac is here for your business.'}</p></div><div class="service-grid">{services.map(s=><article class="service-card"><div class="icon">{s.data.icon}</div><h3>{s.data.title[lang]}</h3><p>{s.data.excerpt[lang]}</p><a class="link-arrow" href={localize('/services',lang)}>{t.readMore} →</a></article>)}</div><p style="text-align:center;margin-top:35px"><a class="button" href={localize('/services',lang)}>{t.allServices} →</a></p></div></section>
<section class="section about-band"><div class="container about-grid"><div class="about-art"></div><div><p class="eyebrow">Why VDac</p><h2>{lang==='vi'?'Một đối tác hiểu doanh nghiệp Việt':'A partner who understands Vietnamese business'}</h2><p>Chúng tôi không chỉ ghi nhận quá khứ. VDac giúp bạn nhìn thấy cơ hội phía trước bằng thông tin chính xác, đúng lúc và dễ hành động.</p><ul class="checklist"><li>Đội ngũ chuyên môn giàu kinh nghiệm thực chiến</li><li>Quy trình minh bạch, bảo mật tuyệt đối</li><li>Giải pháp linh hoạt theo từng giai đoạn tăng trưởng</li></ul><a class="link-arrow" href={localize('/about',lang)}>Khám phá câu chuyện VDac →</a></div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><p class="eyebrow">Insights</p><h2>{t.latestNews}</h2></div><a class="link-arrow" href={localize('/news',lang)}>{lang==='vi'?'Xem tất cả':'View all'} →</a></div><div class="news-grid">{news.map(n=><article class="news-card"><div class="news-image"></div><div class="news-copy"><p class="meta">{n.data.category[lang]} · {n.data.date.toLocaleDateString(lang==='vi'?'vi-VN':'en-US')}</p><h3>{n.data.title[lang]}</h3><p>{n.data.excerpt[lang]}</p><a class="link-arrow" href={localize('/news',lang)}>{t.readMore} →</a></div></article>)}</div></div></section>
<section class="cta"><div class="container"><div><p class="eyebrow" style="color:#bde7f0">START A CONVERSATION</p><h2>{lang==='vi'?'Hôm nay, hãy để tài chính trở thành lợi thế của bạn.':'Let finance become your competitive advantage today.'}</h2></div><a class="button" href={localize('/contact',lang)}>{t.consultation} →</a></div></section></BaseLayout>
