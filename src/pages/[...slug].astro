---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro'; import { getCollection } from 'astro:content'; import { getLang, useTranslations, localize } from '../i18n';
export async function getStaticPaths(){return ['about','services','documents','support','news','employee','contact','en','en/about','en/services','en/documents','en/support','en/news','en/employee','en/contact'].map(slug=>({params:{slug}}))}
const lang=getLang(Astro.url),t=useTranslations(lang),slug=Astro.params.slug||''; const key=slug.split('/').pop()||'';
const copy:any={about:{vi:['Về VDac','Từ năm 2012, VDac đã góp phần xây dựng những doanh nghiệp vận hành minh bạch và phát triển bền vững.'],en:['About VDac','Since 2012, VDac has helped businesses operate transparently and grow sustainably.']},services:{vi:['Dịch vụ của chúng tôi','Hệ sinh thái dịch vụ tài chính – kế toán được thiết kế theo đúng nhu cầu của bạn.'],en:['Our services','An accounting and financial services ecosystem designed around your needs.']},documents:{vi:['Tài liệu & Biểu mẫu','Kho kiến thức, biểu mẫu và tài liệu hữu ích dành cho doanh nghiệp.'],en:['Documents & Resources','A useful library of knowledge, forms, and resources for your business.']},support:{vi:['Hỗ trợ khách hàng','Chúng tôi luôn sẵn sàng lắng nghe và hỗ trợ doanh nghiệp của bạn.'],en:['Customer support','We are ready to listen and support your business whenever needed.']},news:{vi:['Tin tức & Sự kiện','Những cập nhật, góc nhìn và câu chuyện mới nhất từ VDac.'],en:['News & Events','Latest updates, insights, and stories from VDac.']},employee:{vi:['Đội ngũ VDac','Những con người tận tâm đứng sau mỗi giải pháp vững vàng.'],en:['The VDac team','Dedicated people behind every dependable solution.']},contact:{vi:['Kết nối cùng VDac','Bắt đầu cuộc trò chuyện về hành trình tài chính của doanh nghiệp bạn.'],en:['Connect with VDac','Start a conversation about your business financial journey.']}};
const [heading,intro]=copy[key]?.[lang]||copy.about[lang]; const services=key==='services'?(await getCollection('services')).sort((a,b)=>a.data.order-b.data.order):[]; const docs=key==='documents'?await getCollection('documents'):[]; const news=key==='news'?await getCollection('news'):[];
---
<BaseLayout title={`${heading} | VDac`}><section class="page-hero"><div class="container"><p class="eyebrow">VDac / {t[key as keyof typeof t] || key}</p><h1>{heading}</h1><p>{intro}</p></div></section><section class="section"><div class="container">
{key==='services' && <div class="service-grid">{services.map(s=><article class="service-card"><div class="icon">{s.data.icon}</div><h3>{s.data.title[lang]}</h3><p>{s.data.excerpt[lang]}</p><a class="link-arrow" href={localize('/contact',lang)}>{t.consultation} →</a></article>)}</div>}
{key==='documents' && <div class="content-list">{docs.map(d=><article class="doc-item"><div><p class="meta">{d.data.category[lang]} · {d.data.date.toLocaleDateString()}</p><h3>{d.data.title[lang]}</h3><p>{d.data.excerpt[lang]}</p></div><a class="button" href={d.data.file}>Tải xuống ↓</a></article>)}</div>}
{key==='news' && <div class="news-grid">{news.map(n=><article class="news-card"><div class="news-image"></div><div class="news-copy"><p class="meta">{n.data.category[lang]} · {n.data.date.toLocaleDateString()}</p><h3>{n.data.title[lang]}</h3><p>{n.data.excerpt[lang]}</p><a class="link-arrow" href="#">{t.readMore} →</a></div></article>)}</div>}
{key==='contact' && <div class="contact-grid"><div class="contact-details"><h2>VDac.</h2><p><b>{t.address}</b><br/>28 Nguyễn Văn Trỗi, Phường 15<br/>Phú Nhuận, TP. Hồ Chí Minh</p><p><b>{t.phone}</b><br/>028 7300 8899</p><p><b>{t.email}</b><br/>vdac@vdac.com.vn</p></div><form class="form"><input placeholder={lang==='vi'?'Họ và tên':'Your name'}/><input type="email" placeholder="Email"/><input placeholder={lang==='vi'?'Số điện thoại':'Phone number'}/><textarea placeholder={lang==='vi'?'Bạn cần VDac hỗ trợ điều gì?':'How can we help you?'}></textarea><button class="button">{lang==='vi'?'Gửi yêu cầu':'Send request'} →</button></form></div>}
{['about','support','employee'].includes(key) && <div style="max-width:760px"><h2>{key==='employee'?(lang==='vi'?'Tận tâm trong từng con số.':'Dedicated in every detail.'):key==='support'?(lang==='vi'?'Luôn gần để hỗ trợ nhanh.':'Always close, always responsive.'):(lang==='vi'?'Tầm nhìn của chúng tôi.':'Our perspective.')}</h2><p>VDac kết hợp chuyên môn sâu, công nghệ phù hợp và sự thấu hiểu thực tế để mang lại trải nghiệm tin cậy cho khách hàng. Mỗi giải pháp được xây dựng với tinh thần đồng hành lâu dài, rõ ràng và hiệu quả.</p><p><a class="button" href={localize('/contact',lang)}>{t.consultation} →</a></p></div>}
</div></section></BaseLayout>
